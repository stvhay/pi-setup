+export function mapMediaDataUriSegments(
+  value: string,
+  replaceMedia: (media: string) => string,
+  replaceText: (text: string) => string = (text) => text,
+): string {
+  let output = "";
+  let offset = 0;
+  let matched = false;
+
+  for (const match of value.matchAll(MEDIA_DATA_URI_CANDIDATE_RE)) {
+    matched = true;
+    output += replaceText(value.slice(offset, match.index));
+    output += isLangfuseMediaDataUri(match[0])
+      ? replaceMedia(match[0])
+      : MALFORMED_MEDIA_DATA_URI;
+    offset = match.index + match[0].length;
+  }
+
+  return matched ? output + replaceText(value.slice(offset)) : replaceText(value);
+}
