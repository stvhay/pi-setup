+function hasValidBase64Encoding(value: string): boolean {
+  if (!value || !BASE64_VALUE_RE.test(value)) {
+    return false;
+  }
+
+  const unpadded = value.replace(/=+$/, "");
+  const remainder = unpadded.length % 4;
+  const finalIndex = BASE64_ALPHABET.indexOf(unpadded.at(-1) ?? "");
+  return remainder === 0
+    || (remainder === 2 && (finalIndex & 0b1111) === 0)
+    || (remainder === 3 && (finalIndex & 0b11) === 0);
+}
