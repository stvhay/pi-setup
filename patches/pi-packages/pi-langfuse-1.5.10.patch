+export function isLangfuseMediaDataUri(value: string): boolean {
+  const separator = ";base64,";
+  const separatorIndex = value.indexOf(separator);
+  if (!value.startsWith("data:") || separatorIndex < 6) {
+    return false;
+  }
+
+  const mediaType = value.slice(5, separatorIndex);
+  const encoded = value.slice(separatorIndex + separator.length);
+  return SAFE_MEDIA_TYPE_RE.test(mediaType)
+    && hasValidBase64Encoding(encoded)
+    && redactSensitiveText(value) === value;
+}
