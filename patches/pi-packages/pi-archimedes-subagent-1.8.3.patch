+    if (keys.length >= budget.remaining) throw new RangeError("fingerprint input is too large");
+    keys.push(key);
+  }
+  keys.sort();
+  return Object.fromEntries(
+    keys.map((key) => [key, canonicalJsonValue(record[key], depth + 1, budget)]),
+  );
