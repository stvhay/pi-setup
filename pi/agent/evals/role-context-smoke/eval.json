{
  "schemaVersion": 1,
  "id": "role-context-smoke",
  "summary": "Smoke-test default global+project role discovery and generated instruction context.",
  "kind": "instructions",
  "cases": [
    {
      "name": "code-reviewer-role",
      "args": ["--role", "code-reviewer", "--context", "openrouter/minimax/minimax-m3"],
      "contains": ["# Role: code reviewer", "### Verdict: PASS | NEEDS_WORK | NOT_SURE", "# Project Instructions"]
    },
    {
      "name": "implementation-worker-role",
      "args": ["--role", "implementation-worker", "--context", "openai-codex/gpt-5.6-luna"],
      "contains": ["# Role: implementation worker", "Do not push, merge, reset, clean", "agnt work direct-start <id> [--claim]", "Work directly in the current Pi session by default", "implementation approval includes staging and one local atomic commit", "Ticket gateway, run artifacts, worktree-per-epic dispatch, and strict orchestration are opt-in", "Use transient `ask`", "Use durable `ticket_question`", "Approvals are not questions", "# Project Instructions"]
    },
    {
      "name": "verifier-role",
      "args": ["--role", "verifier"],
      "contains": ["# Role: verifier", "NOT_VERIFIED", "# Project Instructions"]
    },
    {
      "name": "finding-discoverer-role",
      "args": ["--role", "finding-discoverer", "--context", "openai-codex/gpt-5.6-luna"],
      "contains": ["# Role: finding discoverer", "specific failure scenario", "review-findings.schema.json"]
    },
    {
      "name": "finding-verifier-role",
      "args": ["--role", "finding-verifier", "--context", "openai-codex/gpt-5.6-sol"],
      "contains": ["# Role: finding verifier", "Treat every discovery finding as a hypothesis to refute", "confirmed", "refuted", "unresolved"]
    }
  ]
}
