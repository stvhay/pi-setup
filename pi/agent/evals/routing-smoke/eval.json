{
  "schemaVersion": 1,
  "id": "routing-smoke",
  "summary": "Smoke-test deterministic agnt route recommendations.",
  "kind": "route",
  "cases": [
    {
      "name": "review-astra-medium-default",
      "args": ["--task", "review", "--risk", "medium", "--budget", "cheap", "--monthly-paid-spend", "0", "--ignore-history"],
      "assert": {"exitCode": 0, "routeStatus": "selected", "selected": "openai-codex/gpt-6-astra", "thinkingLevel": "medium", "fanoutRecommended": true}
    },
    {
      "name": "planning-astra-medium-default",
      "args": ["--task", "planning", "--ignore-history"],
      "assert": {"exitCode": 0, "routeStatus": "selected", "selected": "openai-codex/gpt-6-astra", "thinkingLevel": "medium"}
    },
    {
      "name": "research-astra-medium-default",
      "args": ["--task", "research", "--context-tokens", "200000", "--ignore-history"],
      "assert": {"exitCode": 0, "routeStatus": "selected", "selected": "openai-codex/gpt-6-astra", "thinkingLevel": "medium"}
    },
    {
      "name": "cheap-peer-terra-low",
      "args": ["--task", "cheap-peer", "--risk", "low", "--budget", "cheap", "--ignore-history"],
      "assert": {"exitCode": 0, "routeStatus": "selected", "selected": "openai-codex/gpt-5.6-terra", "thinkingLevel": "low"}
    },
    {
      "name": "orchestration-low-policy",
      "args": ["--task", "orchestration", "--risk", "low", "--ignore-history"],
      "assert": {"exitCode": 0, "routeStatus": "selected", "selected": "openai-codex/gpt-6-astra", "thinkingLevel": "high"}
    },
    {
      "name": "orchestration-high-quality",
      "args": ["--task", "orchestration", "--risk", "high", "--budget", "quality", "--ignore-history"],
      "assert": {"exitCode": 0, "routeStatus": "selected", "selected": "openai-codex/gpt-6-astra", "thinkingLevel": "high"}
    },
    {
      "name": "review-repository-subscription-agentic",
      "args": ["--task", "review", "--risk", "medium", "--access", "repository", "--fanout-size", "3", "--monthly-paid-spend", "0", "--ignore-history"],
      "assert": {"exitCode": 0, "routeStatus": "selected", "selected": "openai-codex/gpt-6-astra", "sourceAccess": "repository", "executionMode": "agentic"}
    },
    {
      "name": "review-impossible-video-context",
      "args": ["--task", "review", "--context-tokens", "999999999", "--modality", "video", "--ignore-history"],
      "assert": {"exitCode": 1, "routeStatus": "no_candidate", "selected": false}
    }
  ]
}
