#!/usr/bin/env python3
"""Front controller for Pi agent helper commands."""
from __future__ import annotations

import argparse
import shutil
import sys
from pathlib import Path
from typing import List

ROOT = Path(__file__).resolve().parent.parent
BIN = ROOT / "bin"
sys.path.insert(0, str(BIN))

from agnt_lib.core import BIN, ROOT, die, run  # noqa: E402
from agnt_lib.tasks import *  # noqa: E402,F401,F403
from agnt_lib.runtime_paths import *  # noqa: E402,F401,F403
from agnt_lib.provider_circuits import *  # noqa: E402,F401,F403
from agnt_lib.metrics import *  # noqa: E402,F401,F403
from agnt_lib.review import *  # noqa: E402,F401,F403
from agnt_lib.invoke import *  # noqa: E402,F401,F403
from agnt_lib.routing import *  # noqa: E402,F401,F403
from agnt_lib.evals import *  # noqa: E402,F401,F403
from agnt_lib.prompt import *  # noqa: E402,F401,F403
from agnt_lib.actions import *  # noqa: E402,F401,F403
from agnt_lib.runs import *  # noqa: E402,F401,F403
from agnt_lib.work import *  # noqa: E402,F401,F403
from agnt_lib.orchestration import *  # noqa: E402,F401,F403
from agnt_lib.approvals import *  # noqa: E402,F401,F403
from agnt_lib.gateway import *  # noqa: E402,F401,F403
from agnt_lib.worktree_policy import *  # noqa: E402,F401,F403
from agnt_lib.health import *  # noqa: E402,F401,F403
from agnt_lib.maintenance import *  # noqa: E402,F401,F403
from agnt_lib.context_health import *  # noqa: E402,F401,F403
from agnt_lib.doctor import *  # noqa: E402,F401,F403
from agnt_lib.langfuse import *  # noqa: E402,F401,F403
from agnt_lib.quality import *  # noqa: E402,F401,F403
from agnt_lib.improvement import *  # noqa: E402,F401,F403

def cmd_instructions(argv: List[str]) -> int:
    return run([str(BIN / "agent-instructions"), *argv])


def cmd_graphify(argv: List[str]) -> int:
    """Run graphify through the Pi helper surface."""
    graphify = shutil.which("graphify")
    if graphify:
        return run([graphify, *argv])
    if shutil.which("uv"):
        return run(["uv", "tool", "run", "--from", "graphifyy", "graphify", *argv])
    die("Graphify is unavailable. Install `graphifyy` or use an environment with `uv`.", 1)


def main(argv: List[str]) -> int:
    commands = {
        "tasks": ("list task/model routing hints", cmd_tasks),
        "web-search": ("search the web", lambda args: run([str(BIN / "web-search"), *args])),
        "web-fetch": ("fetch a URL", lambda args: run([str(BIN / "web-fetch"), *args])),
        "instructions": ("generate layered instructions", cmd_instructions),
        "route": ("recommend a model for a task", cmd_route),
        "runtime-path": ("resolve a safe private runtime directory", cmd_runtime_path),
        "provider-circuit": ("inspect or update provider-venue circuits", cmd_provider_circuit),
        "metrics": ("inspect and consolidate invocation metrics", cmd_metrics),
        "review": ("validate and summarize structured review findings", cmd_review),
        "eval": ("run filesystem-defined agnt evals", cmd_eval),
        "prompt": ("inventory prompts and instructions", cmd_prompt),
        "action": ("list, validate, and render prompt/action templates", cmd_action),
        "runs": ("create and validate invocation/result run artifacts", cmd_runs),
        "work": ("inspect beads-backed ready work and dispatch/run artifacts", cmd_work),
        "approvals": ("create and resolve Beads-backed questions/approval gates", cmd_approvals),
        "gateway": ("execute strict ticket gateway operations", cmd_gateway),
        "context-health": ("check active context for stale terms and entropy signals", cmd_context_health),
        "doctor": ("check local Pi/agnt operational readiness", cmd_doctor),
        "langfuse": ("check or apply tracked evaluator configuration", cmd_langfuse),
        "improve": ("scan and review private improvement telemetry", cmd_improve),
        "quality": ("capture private quality facts", cmd_quality),
        "graphify": ("run graphify knowledge-graph tooling", cmd_graphify),
        "plans-dir": ("print/create the active plans directory", cmd_plans_dir),
    }
    parser = argparse.ArgumentParser(prog="agnt", description="Pi agent helper command surface.")
    sub = parser.add_subparsers(dest="command")
    for name, (help_text, _handler) in commands.items():
        sub.add_parser(name, help=help_text)

    if not argv:
        parser.print_help()
        return 0
    command, rest = argv[0], argv[1:]
    if command in {"-h", "--help"}:
        parser.print_help()
        return 0
    entry = commands.get(command)
    if entry:
        return entry[1](rest)
    parser.print_help(sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
